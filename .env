            {
              "language": "javascript",
              "name": "unb-api.js",
              "code": "const { Client } = require('unb-api');\nconst client = new Client('API_TOKEN');\n\nconst guildId = '305129477627969547';\n\nclient.getGuildLeaderboard(guildId, { sort: 'cash' });\n"
            }
          ],
          "samples-languages": [
